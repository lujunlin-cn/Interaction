# 数据库（Docker postgres:16，宿主机端口 5433，避开系统 PG 5432）
DATABASE_URL=postgresql+asyncpg://drama:drama@127.0.0.1:5433/interaction_drama

# Provider 运行模式：mock（离线零费用）/ live（PRD 冻结矩阵）/ hybrid（冻结矩阵+显式降级）
PROVIDER_MODE=hybrid

# Runtime Profile：AGENT_LOCAL_PROFILE / VIDEO_LOCAL_PROFILE
RUNTIME_PROFILE=AGENT_LOCAL_PROFILE
PROFILE_LIFECYCLE_ENABLED=false
NEMOTRON_CONTAINER=interaction-nemotron
VIDEO_LOCAL_CONTAINER=comfyui-nvidia
VIDEO_LOCAL_STOP_COMMAND=
VIDEO_LOCAL_START_COMMAND=
VIDEO_LOCAL_PROCESS_PATTERN=

# StepFun（文本：Director fallback / Narrative / Authoring）
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP37_MODEL=step-3.7-flash
STEP5_MODEL=step-5-preview

# fal.ai H3 Max（云端视频）
FAL_KEY=
FAL_H3_MODEL=minimax/h3-max/reference-to-video

# Jev / TypeSafe SystemOne（决策评估：路由 / 排序 / 置信 / 升级）
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# DGX Spark 本地 vLLM（Nemotron 3.5 Lightning 30B-A3B NVFP4）
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
DIRECTOR_LOCAL_MAX_CONCURRENCY=2
DIRECTOR_QUEUE_TIMEOUT_SECONDS=10
DIRECTOR_QUEUE_MAX=16
DIRECTOR_LOCAL_REQUEST_TIMEOUT_SECONDS=90

# 媒体与素材存储（相对 backend/ 目录）
DATA_DIR=./data
MEDIA_DIR=./data/media

# 调度默认值（PRD 12.2）
BUDGET_TOTAL=500
BUDGET_PER_TURN=60
TARGET_K=3
SHOTS_PER_BRANCH=2
BRANCH_TTL_SECONDS=180
